# subtitle-ocr-cli：复刻 ocr-lab subtitle-ocr 的 6 个 CLI 二进制（git 源依赖）。
set unstable
set lists
# 用法（在 packages/subtitle-ocr-cli/ 下）：
#   just                       # 默认 = 显示任务列表
#   just build                 # release 编译全部二进制
#   just test                  # 跑单测
#   just run <image>           # 单图识别（输出逐帧 JSON 数组到 stdout）
#   just run-dir <dir>         # 批量识别（文件名须为 ms / ms_ms 时间格式）
#   just run-out <image> <out> # 单图识别并写出 OcrFramesResult 到指定文件
#   just merge <frames> [out]  # 多帧合并：逐帧 JSON → 带时间轴字幕段
#   just adjust-box <frames> [out]  # 字幕框调整：逐帧 JSON(含boxes) → 调整后框+meta
#   just filter-box <adj> [out]     # 离群框过滤：adjust 输出 → 干净逐帧结果
#   just adjust-segment <in> [out]  # 字幕段置信度调整：合并段 → 带惩罚/调整后置信度
#   just filter-segment <adj> [out] # 字幕段过滤：adjust 输出 → 按阈值丢弃低置信段
#
# 输出：stdout 为与 cpp 同形状的 JSON 数组（text/confidence/boxes/timestamp）；
#       --out 额外落地 OcrFramesResult（{frames, meta}），文件名由调用方指定
#       （如 asr_ocr_frames.json / sf_ocr_frames.json），对齐 LocalDub。
#
# 模型目录默认仓库根 models/rapidocr（--model-dir 可覆盖，也支持 OCR_MODELS_DIR）。

# ---- 默认任务（`just` 无参即显示列表） ----
default:
    @just --list

# ---- 编译（debug，快速验证） ----
build:
    cargo build -p subtitle-ocr-cli --bins

# ---- 编译（release，含 LTO） ----
build-release:
    cargo build -p subtitle-ocr-cli --release --bins

# ---- 单测 ----
test:
    cargo test -p subtitle-ocr-cli

# ---- 单图识别（位置传图，输出 JSON 数组到 stdout） ----
# 用法：just run <image>
run-one image="tmp/both_fullscreen_frame1.png":
    cargo run -p subtitle-ocr-cli --bin subtitle-ocr --release -- {{image}}

# ---- 批量识别（--dir，文件名须为 ms / ms_ms 时间格式） ----
# 用法：just run-dir <dir>
run-dir dir="workfolder/深宫团宠，猫狗皇子皆是我的心头崽（30集）/第3集/asr_ocr_pre/frames" out="workfolder/深宫团宠，猫狗皇子皆是我的心头崽（30集）/第3集/asr_ocr/frames.json":
    cargo run -p subtitle-ocr-cli --bin subtitle-ocr --release -- --model-dir data/models/rapidocr --dir {{dir}} --out {{out}}

# ---- 统合后处理管线：一条命令串起 adjust-box → filter-box → merge → adjust-segment → filter-segment ----
# 用法：just ocr-post [frames] [video] [out] [threshold] [stop_at]
# 输入 frames（逐帧 OCR JSON，subtitle-ocr --out 产出）与 video（视频路径，读高度）；
# 各中间产物（frames_box_adjust.json / frames_box_filter.json / frames_merged.json /
# segment_adjust.json / segment_filter.json）都写到 out 目录。--stop-at 可只跑到某一步。
ocr-post frames="workfolder/深宫团宠，猫狗皇子皆是我的心头崽（30集）/第3集/sf_ocr/frames.json" video="workfolder/深宫团宠，猫狗皇子皆是我的心头崽（30集）/第3集/video_source.mp4" out="workfolder/深宫团宠，猫狗皇子皆是我的心头崽（30集）/第3集/sf_ocr_fix" threshold="0.5" stop_at="filter-segment":
    cargo run -p subtitle-ocr-cli --bin ocr-post --release -- --frames {{frames}} --video {{video}} --out {{out}} --threshold {{threshold}} --stop-at {{stop_at}}

# ---- 全参数批量识别（--dir + 所有可选 flag） ----
# 参数全部为 long option（跳过中间参数无需占位；布尔 flag 直接传 --xxx 即开启）；
# dir 为必填（无默认值），其余有默认值。
# 用法：
#   just run --dir <frames> --out <out.json> \
#        [--model v3] [--model-dir data/models/rapidocr] [--text-confidence-threshold 0.5] \
#        [--subtitle-only] [--full-frame] [--no-nms] [--warp-crop] [--threads 4]
[arg("dir", long="dir", help="帧图片目录（文件名须为 ms / ms_ms 时间格式）")]
[arg("out", long="out", help="输出 OcrFramesResult JSON 文件路径")]
[arg("model", long="model", help="模型套件：v3 / v6-tiny / v6-medium")]
[arg("model_dir", long="model-dir", help="模型目录（默认仓库根 data/models/rapidocr）")]
[arg("text_confidence_threshold", long="text-confidence-threshold", help="识别置信度下限（默认 0.5）")]
[arg("subtitle_only", long="subtitle-only", value="--subtitle-only", help="仅保留画面底部比例区间的字幕框")]
[arg("full_frame", long="full-frame", value="--full-frame", help="关闭 bottom_only，对整帧做 OCR")]
[arg("no_nms", long="no-nms", value="--no-nms", help="关闭重叠框 NMS 去重")]
[arg("warp_crop", long="warp-crop", value="--warp-crop", help="用透视矫正裁剪替代轴对齐包围盒")]
[arg("threads", long="threads", help="推理线程数")]
run \
    dir="" \
    out="" \
    model="v3" \
    model_dir="data/models/rapidocr" \
    text_confidence_threshold="0.5" \
    subtitle_only="" \
    full_frame="" \
    no_nms="" \
    warp_crop="" \
    threads="":
    cargo run -p subtitle-ocr-cli --bin subtitle-ocr --release -- \
        --model {{model}} --model-dir {{model_dir}} \
        --dir {{dir}} --out {{out}} \
        --text-confidence-threshold {{text_confidence_threshold}} \
        {{subtitle_only}} {{full_frame}} {{no_nms}} {{warp_crop}} \
        {{ if (threads != "") { "--threads " + threads } else { "" } }}

# ---- 单图识别并写出 OcrFramesResult 到调用方指定文件 ----
# 用法：just run-out <image> <out>
run-out image="tmp/both_fullscreen_frame1.png" out="tmp/ocr_frames.json":
    cargo run -p subtitle-ocr-cli --bin subtitle-ocr --release -- {{image}} --out {{out}}

# ---- 多帧合并：把逐帧 JSON（asr_ocr_frames.json 等）合并成带时间轴的字幕段 ----
# 用法：just merge <frames.json> [out]
# 输入为主 CLI（subtitle-ocr --out）产出的 FrameResult[] 或 {frames,meta}；
# 输出 MergeFramesResult { text, segments } 到 stdout（--out 额外落盘）。
merge in="tmp/asr_ocr_frames.json" out="tmp/merged.json":
    cargo run -p subtitle-ocr-cli --bin merge-frames --release -- {{in}} --out {{out}}

# ---- 字幕框调整：给逐帧 JSON 的框算偏离/噪声惩罚、标记离群 ----
# 用法：just adjust-box <frames.json> [out]
# 输入须含 boxes（调整依赖框几何），由主 CLI（subtitle-ocr --out）产出；
# 输出 OcrBoxAdjustResult { frames, meta } 到 stdout（--out 额外落盘）。
adjust-box in="tmp/asr_ocr_frames.json" out="tmp/adjusted.json":
    cargo run -p subtitle-ocr-cli --bin ocr-frames-adjust-box --release -- {{in}} --out {{out}}

# ---- 离群框过滤：剔除 is_outlier 框、重聚合得到干净帧 ----
# 用法：just filter-box <adjusted.json> [out]
# 输入为 adjust-box 步骤的输出（含 is_outlier 标记）；
# 输出 OcrFramesBoxFilteredResult { frames, meta } 到 stdout（--out 额外落盘）。
filter-box in="tmp/adjusted.json" out="tmp/filtered.json":
    cargo run -p subtitle-ocr-cli --bin ocr-frames-filter-box --release -- {{in}} --out {{out}}

# ---- 字幕段置信度调整：给合并段补 Y 偏移/孤立惩罚与调整后置信度 ----
# 用法：just adjust-segment <input.json> [out]
# 输入为打包 JSON（segments/frames/video_height + 可选 y_stats/args），通常由
# merge-frames 的 segments 与目录识别的 frames 组装而来；
# 输出 OcrSegmentWithAdjust[] 到 stdout（--out 额外落盘），供下游 ocr-segment-filter 消费。
adjust-segment in="tmp/segment_adjust_in.json" out="tmp/segment_adjusted.json":
    cargo run -p subtitle-ocr-cli --bin ocr-segment-adjust --release -- {{in}} --out {{out}}

# ---- 字幕段置信度过滤：按阈值丢弃低置信段 ----
# 用法：just filter-segment <adjusted.json> [out] [threshold]
# 输入为 adjust-segment 步骤的输出（含 adjusted_confidence）；
# 输出 OcrSegmentFilterResult { meta, result } 到 stdout（--out 额外落盘）；
# 加 --bare 则输出纯 OcrSegmentWithAdjust[] 数组。
filter-segment in="tmp/segment_adjusted.json" out="tmp/segment_filtered.json" threshold="0.5":
    cargo run -p subtitle-ocr-cli --bin ocr-segment-filter --release -- {{in}} --text-confidence-threshold {{threshold}} --out {{out}}
