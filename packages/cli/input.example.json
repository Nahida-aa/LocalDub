{
  "$schema": "./input.schema.json",
  "command": "task",
  "task": {
    "action": "start",
    "url": "/home/aa/下载/大/36.mp4",
    "taskDir": "/home/aa/repos/env_ls/LocalDub/workfolder/大/22",
    "continueFrom": "tts",
    "targetStage": "mix_video",
    "pipeline": "dub",
    "subtitleSource": "sf_ocr"
  },
  "check": {
    "type": "font"
  },
  "env": {
    "action": "check",
    "targets": ["ffmpeg"]
  },
  "servers": {
    "action": "discovery",
    "name": "voxcpm_torch_gradio"
  },
  "stages": {
    "separate": {
      "runtime": "burn-tch",
      "device": "cpu",
      "always": true
    },
    "asr": {
      "runtime": "ggml",
      "device": "vulkan",
      "useSeparated": true,
      "mixMode": "sidechain",
      "vad": true,
      "vadModel": "silero-v6",
      "wordsOutput": true
    },
    "asr_ocr": {
      "runtime": "ort-rust",
      "textScore": 0.45
    },
    "asr_ocr_fix": {
      "is_resample": false,
      "llmFix": true
    },
    "asr_fix": {
      "llmFix": true,
      "domainHint": "仙侠, 系统; 角色: 叶白, 慧天；术语：灵石、灵根、剑仙、心性定力、系统伴生、资质上乘、狮子歌歌、一刀流居合死; 常见纠错: 夜白->叶白, 在为我喝汤->在喂我喝汤, 这般茅造->这般毛躁, 对上他那时->对上他那式, 无波无言->无波无澜, 就叫谁胜谁负->究竟谁胜谁负; 根据上下文的纠错:(万一夜白忍不住宰了慧天怎么办)->(万一叶白忍不住宰了慧天怎么办), (我好想 看到一个老婆婆在喂我喝汤)->(我好像 看到一个老婆婆在喂我喝汤), (一时情节)->(一时情急)"
    },
    "sf_ocr_fix": {
      "llmFix": true
    },
    "translate": {
      "enabled": true,
      "targetLang": "vi",
      "apiBase": "http://localhost:11434/v1",
      "model": "gemma4:31b-cloud"
    },
    "split_audio": {
      "startPadMs": 100,
      "endPadMs": 0,
      "vadAlign": false
    },
    "tts": {
      "runtime": "cloud",
      "device": "cpu",
      "regenIndices": [1, 2, 3]
    },
    "merge_audio": {
      "maxSpeed": 1.55,
      "maxAdvanceMs": 300,
      "maxDelayMs": 300
    },
    "merge_video": {
      "fontSize": 21.4,
      "marginV": 45,
      "font": "Noto Sans CJK SC Medium",
      "shadow": 1.1,
      "bgmGain": -9
    }
  }
}
