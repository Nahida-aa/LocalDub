{
  "$schema": "./input.schema.json",
  "command": "workflow",
  "workflow": {
    "action": "continue",
    "url": "/home/aa/下载/师尊带我炸修真/4",
    "videoDir": "workfolder/师尊带我炸修真/4",
    "continueFrom": "tts",
    "targetStep": "mix_video",
    "pipeline": "dub",
    "subtitleSource": "sf_ocr",
    "sourceLang": "zh",
    "targetLang": "vi",
  },
  "check": {
    "type": "font",
  },
  "env": {
    "action": "check",
    "targets": [],
  },
  "servers": {
    "action": "discovery",
    "name": "main",
  },
  "steps": {
    "separate": {
      "runtime": "burn-tch",
      "device": "cpu",
      "always": true,
    },
    "asr": {
      "runtime": "ggml",
      "device": "vulkan",
      "useSeparated": true,
      "mixMode": "sidechain",
      "vad": true,
      "vadModel": "silero-v6",
      "wordsOutput": true,
    },
    "asr_fix": {
      "llmFix": true,
    },
    "asr_ocr": {
      "runtime": "ort-rust",
      "textScore": 0.45,
    },
    "asr_ocr_fix": {
      "is_resample": false,
      "llmFix": true,
    },

    "sf_ocr_fix": {
      "llmFix": true,
    },
    "translate": {
      "enabled": true,
      "apiBase": "http://localhost:11434/v1",
      "model": "gemma4:31b-cloud",
    },
    "split_audio": {
      "startPadMs": 100,
      "endPadMs": 0,
      "vadAlign": false,
    },
    "tts": {
      "runtime": "cloud",
      "device": "cpu",
      "regenIndices": [],
    },
    "mix_audio": {
      "maxSpeed": 1.65,
      "maxAdvanceMs": 300,
      "maxDelayMs": 300,
    },
    "mix_video": {
      "fontSize": 21.4,
      "marginV": 50,
      "font": "Noto Sans CJK SC Medium",
      "shadow": 1.1,
      "bgmGain": -9,
    },
  },
}
