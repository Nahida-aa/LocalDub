{
  "$schema": "./input.schema.json",
  "command": "workflow",
  "workflow": {
    "action": "continue",
    "url": "/home/aa/下载/师尊带我炸修真/4",
    "video_dir": "workfolder/师尊带我炸修真/4",
    "continue_from": "tts",
    "target_step": "mix_video",
    "output_mode": "dub",
    "subtitle_source": "sf_ocr",
    "source_lang": "zh",
    "target_lang": "vi",
  },
  "check": {
    "type": "font",
  },
  "env": {
    "action": "check",
    "targets": [],
  },
  "servers": {
    "action": "discovery",
    "name": "main",
  },
  "steps": {
    "separate": {
      "runtime": "burn-tch",
      "device": "cpu",
      "always": true,
    },
    "asr": {
      "runtime": "ggml",
      "device": "vulkan",
      "use_separated": true,
      "mix_mode": "sidechain",
      "vad": true,
      "vad_model": "silero-v6",
      "words_output": true,
    },
    "asr_fix": {
      "llm_fix": true,
    },
    "asr_ocr": {
      "runtime": "ort-rust",
      "text_confidence_threshold": 0.45,
    },
    "asr_ocr_fix": {
      "is_resample": false,
      "llm_fix": true,
    },

    "sf_ocr_fix": {
      "llm_fix": true,
    },
    "translate": {
      "enabled": true,
      "api_base": "http://localhost:11434/v1",
      "model": "gemma4:31b-cloud",
    },
    "split_audio": {
      "start_pad_ms": 100,
      "end_pad_ms": 0,
      "vad_align": false,
    },
    "tts": {
      "runtime": "cloud",
      "device": "cpu",
      "regen_indices": [],
    },
    "mix_audio": {
      "max_speed": 1.65,
      "max_advance_ms": 300,
      "max_delay_ms": 300,
    },
    "mix_video": {
      "font_size": 21.4,
      "margin_v": 50,
      "font": "Noto Sans CJK SC Medium",
      "shadow": 1.1,
      "bgm_gain": -9,
    },
  },
}
